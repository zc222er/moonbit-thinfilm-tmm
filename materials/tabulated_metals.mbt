  let wls = [
    250.0, 300.0, 350.0, 400.0, 450.0, 500.0, 550.0, 580.0, 600.0, 650.0, 700.0,
    750.0, 800.0, 900.0, 1000.0, 1200.0, 1500.0, 1800.0, 2000.0,
