///|
pub fn get_aluminum_rakic() -> @disp.TabulatedDispersion {
  let wls = [
    200.0, 250.0, 300.0, 350.0, 400.0, 450.0, 500.0, 550.0, 600.0, 650.0, 700.0,
    750.0, 800.0, 850.0, 900.0, 1000.0, 1200.0, 1500.0, 1800.0, 2000.0,
  ]
  let n_arr = [
    0.12, 0.20, 0.28, 0.38, 0.49, 0.62, 0.77, 0.96, 1.20, 1.48, 1.82, 2.18, 2.35,
    2.15, 1.82, 1.45, 1.40, 1.55, 1.85, 2.10,
  ]
  let k_arr = [
    2.35, 2.95, 3.55, 4.15, 4.75, 5.32, 5.86, 6.38, 6.85, 7.25, 7.52, 7.60, 7.42,
