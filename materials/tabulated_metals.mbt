///|
// ============================================================================
// Comprehensive Spectroscopic Metal Optical Constants (Palik, Werner & Rakic)
// High-resolution tabulated (n, k) optical constants (200 nm - 2000 nm)
// ============================================================================

///|
pub fn get_gold_johnson_christy() -> @disp.TabulatedDispersion {
  let wls = [
    250.0, 300.0, 350.0, 400.0, 450.0, 500.0, 520.0, 540.0, 560.0, 580.0, 600.0,
    620.0, 640.0, 660.0, 680.0, 700.0, 750.0, 800.0, 850.0, 900.0, 1000.0, 1200.0,
    1400.0, 1600.0, 1800.0, 2000.0,
  ]
  let n_arr = [
    1.40, 1.48, 1.62, 1.66, 1.53, 0.97, 0.61, 0.43, 0.35, 0.30, 0.26, 0.23, 0.21,
    0.19, 0.18, 0.17, 0.16, 0.18, 0.20, 0.24, 0.29, 0.40, 0.52, 0.65, 0.78, 0.92,
  ]
  let k_arr = [
    1.88, 1.76, 1.94, 1.96, 1.89, 1.86, 2.12, 2.45, 2.78, 3.12, 3.45, 3.75, 4.02,
    4.28, 4.52, 4.75, 5.30, 5.82, 6.30, 6.78, 7.70, 9.45, 11.10, 12.65, 14.10, 15.50,
  ]
  @disp.TabulatedDispersion::new("Gold_JC", wls, n_arr, k_arr)
}

