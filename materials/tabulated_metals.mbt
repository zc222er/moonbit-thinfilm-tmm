///|
pub fn get_molybdenum_spectrum() -> @disp.TabulatedDispersion {
  // Molybdenum Mo back contact for CIGS and CZTS thin film solar cells
  let wls = [
    300.0, 400.0, 500.0, 600.0, 700.0, 800.0, 900.0, 1000.0, 1200.0, 1500.0, 2000.0,
  ]
  let n_arr = [2.85, 3.20, 3.45, 3.68, 3.82, 3.75, 3.55, 3.32, 2.95, 2.65, 2.45]
  let k_arr = [3.15, 3.42, 3.65, 3.85, 4.02, 4.25, 4.55, 4.88, 5.55, 6.45, 7.85]
  @disp.TabulatedDispersion::new("Molybdenum", wls, n_arr, k_arr)
}

///|
pub fn get_palladium_spectrum() -> @disp.TabulatedDispersion {
  // Palladium Pd for hydrogen optical sensing
  let wls = [
    300.0, 400.0, 500.0, 600.0, 700.0, 800.0, 900.0, 1000.0, 1500.0, 2000.0,
  ]
  let n_arr = [1.25, 1.62, 1.95, 2.25, 2.55, 2.85, 3.12, 3.38, 4.45, 5.40]
  let k_arr = [2.15, 2.95, 3.75, 4.45, 5.12, 5.75, 6.32, 6.85, 9.15, 11.20]
  @disp.TabulatedDispersion::new("Palladium", wls, n_arr, k_arr)
}
